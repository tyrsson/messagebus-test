<section id="notes-list">
    <?php if (empty($this->notes)): ?>
        <article>
            <header>
                <h2>Notes</h2>
            </header>
            <p>No notes yet.</p>
        </article>
    <?php else: ?>
        <?php foreach ($this->notes as $note): ?>
            <article>
                <header>
                    <h2>Notes</h2>
                </header>
                <form method="post"
                    action="<?= $this->url('notes.update', ['id' => $note['id']]) ?>"
                    hx-patch="<?= $this->url('notes.update', ['id' => $note['id']]) ?>"
                    hx-target="#notes-list"
                    hx-swap="outerHTML">
                    <fieldset role="group">
                        <input type="text" name="title" required maxlength="255"
                            value="<?= $this->escapeHtml($note['title']) ?>">
                        <button type="submit">Update</button>
                        <button type="button" class="secondary"
                            hx-delete="<?= $this->url('notes.delete', ['id' => $note['id']]) ?>"
                            hx-target="#notes-list"
                            hx-swap="outerHTML">Delete</button>
                    </fieldset>
                    <small><?= $this->escapeHtml($note['created_at']) ?></small>
                </form>
            </article>
        <?php endforeach; ?>
    <?php endif; ?>
</section>
