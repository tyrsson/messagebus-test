<?php $this->headTitle('Notes'); ?>

<article>
    <header>
        <h2>Add a note</h2>
    </header>
    <form method="post"
        action="<?= $this->url('notes.create') ?>"
        hx-post="<?= $this->url('notes.create') ?>"
        hx-target="#notes-list"
        hx-swap="outerHTML"
        hx-on::after-request="if(event.detail.successful) this.reset()">
        <fieldset role="group">
            <input type="text" name="title" required maxlength="255" placeholder="What do you want to remember?">
            <button type="submit">Add</button>
        </fieldset>
    </form>
</article>

<div id="notes-errors"></div>

<section id="notes-list"
    hx-get="<?= $this->url('notes.list') ?>"
    hx-trigger="load"
    hx-swap="outerHTML">
    <p aria-busy="true">Loading notes...</p>
</section>
